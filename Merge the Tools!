def merge_the_tools(string, k):
    for i in range(0, len(string), k):
        sub = string[i:i + k]
        seen = set()
        out = []
        for char in sub:
            if char not in seen:
                seen.add(char)
                out.append(char)
        print("".join(out))

if __name__ == '__main__':
    string, k = input(), int(input())
    merge_the_tools(string, k)
